-main ApplicationMain 
-cp C:/HaxeToolkit/haxe/lib/flixel/5,2,2
-D flixel=5.2.2
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp C:/HaxeToolkit/haxe/lib/openfl/9,2,2/src
-D openfl=9.2.2
--macro lime._internal.macros.DefineMacro.run()
-cp C:/HaxeToolkit/haxe/lib/lime/8,0,1/src
-D lime=8.0.1
--macro keep('IntIterator')
-cp C:/HaxeToolkit/haxe/lib/hscript/2,5,0
-D hscript=2.5.0
-cp C:/HaxeToolkit/haxe/lib/flixel-ui/2,4,0
-D flixel-ui=2.4.0
-cp C:/HaxeToolkit/haxe/lib/flixel-addons/3,0,2
-D flixel-addons=3.0.2
-cp C:/HaxeToolkit/haxe/lib/tjson/1,4,0
-D tjson=1.4.0
-cp source
-D ANDROID_SETUP=true
-D PSYCH_WATERMARKS
-D ANDROID_NDK_ROOT=E:\to android\android-ndk-r24-windows\android-ndk-r24
-D howlerjs
-D lime-webgl
-D lime-dom
-D lime-howlerjs
-D lime-html5
-D openflPos
-D NO_PRELOAD_ALL
-D hscriptPos
-D FLX_NO_FOCUS_LOST_SCREEN
-D tools=8.0.1
-D ANDROID_SDK=E:\to android\Sdk
-D lime-canvas
-D FLX_NO_DEBUG
-D no-deprecation-warnings
-D ACHIEVEMENTS_ALLOWED
-D no-compilation
-D openfl-html5
-D NAPE_RELEASE_BUILD
-D LINC_LUA_RELATIVE_DYNAMIC_LIB
-D JAVA_HOME=C:\Program Files\Java\jdk-21\bin
-D html5
-D web
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()
--macro allowPackage('flash')
--macro include('my.pack')
-js export/release/html5/bin/Bambers Purgatory.js
-cp export/release/html5/haxe
-D html5
-debug